# Variaveis de instalacao de uma nova loja. Copie para deploy/loja.env
# (o .gitignore ja ignora esse arquivo).

# Banco
DB_NAME=cliente_wp
DB_USER=cliente_wp
DB_PASS=
DB_HOST=localhost
DB_PREFIX=lv_

# Site
SITE_URL=https://www.exemplo.com.br
LOJA="Auto Center Exemplo"
SLOGAN="Seminovos revisados, com procedencia"

# Admin
ADMIN_USER=
ADMIN_PASS=
ADMIN_EMAIL=

# Nosso codigo (deixe vazio se for enviar por FTP/rsync)
REPO_TEMA=git@github.com:seuusuario/tema-lv.git
REPO_PLUGIN=git@github.com:seuusuario/plugin-lv-estoque.git

# Caminho ou URL do zip do ACF PRO (licenca unica, sites ilimitados)
ACF_ZIP=
